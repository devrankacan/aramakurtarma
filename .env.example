# Bu dosyayı .env olarak kopyalayıp değerleri ortamına göre doldur.
# Sunucu/subdomain değiştiğinde sadece bu dosya güncellenir; kod değişmez.

# Paylaşımlı bir VPS'e kurulacaksa mutlaka repo adından farklı, benzersiz bir
# değer ver — docker compose container/network/volume isimlerini bu öneke göre
# üretir, böylece sunucudaki diğer projelerle asla çakışmaz.
COMPOSE_PROJECT_NAME=arkur

# Sunucuda BOŞ olduğunu doğruladığın bir port yaz (örn. `sudo ss -tulpn` ile
# kontrol et). Diğer projelerin kullandığı bir portu ASLA seçme.
HTTP_PORT=8091

DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Admin paneline/formlara nereden erişileceğiyse (şema+host+port), CSRF için
# burada da olmalı. IP:port ile test ederken bunu unutma, yoksa "Origin
# checking failed" hatası alırsın.
CSRF_TRUSTED_ORIGINS=http://localhost

# nginx server_name burada; VPS değişince ya da subdomain eklenince tek satır
SERVER_NAME=localhost

POSTGRES_DB=arkur
POSTGRES_USER=arkur
POSTGRES_PASSWORD=arkur
DATABASE_URL=postgres://arkur:arkur@db:5432/arkur

REDIS_URL=redis://redis:6379/0

# Gönüllü formundaki sağlık beyanı gibi özel nitelikli (KVKK) alanların
# şifrelendiği anahtar. Bu satır yorumluyken kod içindeki dev placeholder
# kullanılır — üretimde MUTLAKA aşağıdaki satırın başındaki #'yi kaldırıp
# kendi anahtarınla doldur:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=buraya-uretilen-anahtari-yapistir

# NAC (nac.com.tr) toplu SMS API bilgileri — panelinden/dokümanından al.
NAC_SMS_API_URL=
NAC_SMS_API_KEY=
NAC_SMS_USERNAME=
NAC_SMS_PASSWORD=
NAC_SMS_SENDER_ID=
